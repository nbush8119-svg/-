 "dur": 119.92099999999999,
 "cues": [
  [
   0.2,
   4.2540000000000004,
   "你跟AI聊天，\n它是按字收费的吗？不是。"
  ],
  [
   4.2540000000000004,
   10.667,
   "它按一个你可能天天见、\n却说不清的单位收费：\nToken，中文叫词元。"
  ],
  [
   10.667,
   16.078,
   "用了一年AI，大多数人还是说不上来，\nToken到底是什么。"
  ],
  [
   16.078,
   20.255,
   "今天用费曼学习法，\n四步把Token讲透。"
  ],
  [
   20.255,
   26.351,
   "第一步，选一个概念，\n写在纸的最上方：Token，词元。"
  ],
  [
   26.351,
   30.648,
   "第二步，讲给一个十二岁的孩子听，\n不许用术语。"
  ],
  [
   30.648,
   36.712,
   "AI读一句话，既不是一个字一个字地读，\n也不是一整句一口吞。"
  ],
  [
   36.712,
   41.61,
   "它先把句子切成一小块一小块。\n每一块，就是一个Token。"
  ],
  [
   41.61,
   47.345000000000006,
   "比如，我爱吃火锅，\n可能被切成三块：我，爱吃，火锅。"
  ],
  [
   47.345000000000006,
   53.189,
   "每一块再换成一个编号。\nAI从头到尾看到的，其实是一串数字。"
  ],
  [
   53.189,
   58.565000000000005,
   "它回答你，也是一块一块往外蹦：\n猜下一块，再猜下一块。"
  ],
  [
   58.565000000000005,
   65.69,
   "所以AI收多少钱，按Token算；\n它能记住多长的对话，\n也按Token算。"
  ],
  [
   65.69,
   72.223,
   "第三步，找卡住的地方。\n最常见的误会：AI读字，跟我们一样。"
  ],
  [
   72.223,
   78.485,
   "其实不一样。\n你让它数一个长长的英文单词里\n有几个某个字母，它经常数错。"
  ],
  [
   78.485,
   84.024,
   "不是它笨，是它根本没看见字母。\n它看见的，是切好的一整块。"
  ],
  [
   84.024,
   89.882,
   "就像你拿到的是一袋一袋的米，\n却有人问你，一共有几粒。"
  ],
  [
   89.882,
   95.138,
   "第四步，简化成一句话：\nToken，就是AI眼里的一个字。"
  ],
  [
   95.138,
   103.283,
   "这张卡挂在世界怎么运转这根主干上。\n往下还能长出一张：\nAI到底是怎么猜下一个字的。"
  ],
  [
   103.283,
   109.917,
   "今晚就打开你常用的AI，\n让它数一数一个长单词里的字母，\n看它会不会数错。"
  ],
  [
   109.917,
   111.47,
   "评论区告诉我。"
  ],
  [
   111.47,
   117.121,
   "费曼学习法卡片，\n第三张。我们下一张见。"
  ]
 ],
