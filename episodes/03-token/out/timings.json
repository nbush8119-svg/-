[
 {
  "id": "L01",
  "text": "你跟AI聊天，它是按字收费的吗？不是。",
  "start": 0.25,
  "end": 3.854
 },
 {
  "id": "L02",
  "text": "它按一个你可能天天见、却说不清的单位收费：Token，中文叫词元。",
  "start": 4.304,
  "end": 10.267
 },
 {
  "id": "L03",
  "text": "用了一年AI，大多数人还是说不上来，Token到底是什么。",
  "start": 10.717,
  "end": 15.728
 },
 {
  "id": "L04",
  "text": "今天用费曼学习法，四步把Token讲透。",
  "start": 16.128,
  "end": 19.605
 },
 {
  "id": "L05",
  "text": "第一步，选一个概念，写在纸的最上方：Token，词元。",
  "start": 20.305,
  "end": 25.701
 },
 {
  "id": "L06",
  "text": "第二步，讲给一个十二岁的孩子听，不许用术语。",
  "start": 26.401,
  "end": 30.248
 },
 {
  "id": "L07",
  "text": "AI读一句话，既不是一个字一个字地读，也不是一整句一口吞。",
  "start": 30.698,
  "end": 36.412
 },
 {
  "id": "L08",
  "text": "它先把句子切成一小块一小块。每一块，就是一个Token。",
  "start": 36.762,
  "end": 41.21
 },
 {
  "id": "L09",
  "text": "比如，我爱吃火锅，可能被切成三块：我，爱吃，火锅。",
  "start": 41.66,
  "end": 46.945
 },
 {
  "id": "L10",
  "text": "每一块再换成一个编号。AI从头到尾看到的，其实是一串数字。",
  "start": 47.395,
  "end": 52.789
 },
 {
  "id": "L11",
  "text": "它回答你，也是一块一块往外蹦：猜下一块，再猜下一块。",
  "start": 53.239,
  "end": 58.165
 },
 {
  "id": "L12",
  "text": "所以AI收多少钱，按Token算；它能记住多长的对话，也按Token算。",
  "start": 58.615,
  "end": 65.04
 },
 {
  "id": "L13",
  "text": "第三步，找卡住的地方。最常见的误会：AI读字，跟我们一样。",
  "start": 65.74,
  "end": 71.773
 },
 {
  "id": "L14",
  "text": "其实不一样。你让它数一个长长的英文单词里有几个某个字母，它经常数错。",
  "start": 72.273,
  "end": 78.135
 },
 {
  "id": "L15",
  "text": "不是它笨，是它根本没看见字母。它看见的，是切好的一整块。",
  "start": 78.535,
  "end": 83.674
 },
 {
  "id": "L16",
  "text": "就像你拿到的是一袋一袋的米，却有人问你，一共有几粒。",
  "start": 84.074,
  "end": 89.082
 },
 {
  "id": "L17",
  "text": "第四步，简化成一句话：Token，就是AI眼里的一个字。",
  "start": 89.932,
  "end": 94.638
 },
 {
  "id": "L18",
  "text": "这张卡挂在世界怎么运转这根主干上。往下还能长出一张：AI到底是怎么猜下一个字的。",
  "start": 95.188,
  "end": 102.783
 },
 {
  "id": "L19",
  "text": "今晚就打开你常用的AI，让它数一数一个长单词里的字母，看它会不会数错。",
  "start": 103.333,
  "end": 109.667
 },
 {
  "id": "L20",
  "text": "评论区告诉我。",
  "start": 109.967,
  "end": 110.92
 },
 {
  "id": "L21",
  "text": "费曼学习法卡片，第三张。我们下一张见。",
  "start": 111.52,
  "end": 115.321
 }
]