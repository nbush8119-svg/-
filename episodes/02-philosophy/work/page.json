  ],
  [
   22.989,
   27.875999999999998,
   "第一步，选一个概念，\n写在纸的最上方：哲学。"
  ],
  [
   27.875999999999998,
   32.173,
   "第二步，讲给一个十二岁的孩子听，\n不许用术语。"
  ],
  [
   32.173,
   37.843,
